{
  "functions": {
    "api/storage.js": { "maxDuration": 15 },
    "api/photo.js": { "maxDuration": 30 },
    "api/share.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    {
      "source": "/s/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Googlebot|bingbot"
        }
      ],
      "destination": "/api/share?kind=s&slug=:slug"
    },
    {
      "source": "/showroom/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Googlebot|bingbot"
        }
      ],
      "destination": "/api/share?kind=s&slug=:slug"
    },
    {
      "source": "/shop/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Googlebot|bingbot"
        }
      ],
      "destination": "/api/share?kind=shop&slug=:slug"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
