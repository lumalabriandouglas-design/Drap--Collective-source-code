{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "exclude": [
    "src/pages",
    "src/hooks",
    "src/contexts",
    "src/config",
    "src/constants",
    "src/types",
    "src/components/assistant",
    "src/components/brand",
    "src/components/layout",
    "src/components/placeholder",
    "src/App.tsx",
    "src/index.css",
    "src/sw.js"
  ]
}
